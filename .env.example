# In Portainer unter "Environment variables" eintragen (oder als .env neben docker-compose.yml)
K40_HOST=192.168.1.50
# Nur fuers erste Pairing noetig (Aufkleber am K 40 RF):
K40_USERNAME=
K40_PASSWORD=
# alternativ ein vorhandenes Token:
K40_TOKEN=

MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=k40rf

POLL_INTERVAL=30
INCLUDE_SIGNALS=true
HA_DISCOVERY=true
LOG_LEVEL=INFO
